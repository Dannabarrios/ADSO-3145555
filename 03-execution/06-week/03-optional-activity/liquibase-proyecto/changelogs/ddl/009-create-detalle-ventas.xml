<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="009" author="danna">
        <createTable tableName="detalle_ventas">
            <column name="id" type="SERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id_venta" type="INTEGER">
                <constraints nullable="false" foreignKeyName="fk_detalle_venta" references="ventas(id)"/>
            </column>
            <column name="id_libro" type="INTEGER">
                <constraints nullable="false" foreignKeyName="fk_detalle_libro" references="libros(id)"/>
            </column>
            <column name="cantidad" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="precio_unit" type="NUMERIC(10,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>